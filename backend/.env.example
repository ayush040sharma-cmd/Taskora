PORT=3001
DATABASE_URL=postgresql://user:password@host/kanban_db
JWT_SECRET=replace_with_a_long_random_string
NODE_ENV=production

# Frontend origin — used for CORS allowlist, OAuth redirects, invite/reset links
FRONTEND_URL=https://taskora.io
# Backend's own public URL — used to build the Google OAuth callback URL.
# Set to this service's actual Render URL, or https://api.taskora.io if that
# custom domain has been added in Render.
BACKEND_URL=https://your-backend-url

# Google OAuth (optional — omit to disable "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email — Resend (https://resend.com)
# Requires the taskora.io domain to be verified in Resend (SPF/DKIM) before
# support@taskora.io can be used as the From address.
RESEND_API_KEY=
FROM_EMAIL="Taskora <support@taskora.io>"
EMAIL_REPLY_TO=support@taskora.io

# Licensing — internal users (comma-separated email domains) bypass all
# pricing restrictions. Leave unset to disable (no one is treated as internal).
INTERNAL_DOMAINS=

# Payments — Razorpay (https://dashboard.razorpay.com/app/keys)
# Test-mode keys start with rzp_test_; live keys start with rzp_live_.
# KEY_SECRET is server-side only — never expose it to frontend code.
# Without these set, /api/payments/create-order returns a mock order for dev.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Pricing — whole-currency-unit prices (e.g. 7 = $7.00), not the smallest
# unit Razorpay's API expects — payments.js converts internally. Defaults
# below (USD, 7, 25) match current production pricing if left unset.
PAYMENT_CURRENCY=USD
PRO_PLAN_PRICE=7
ENTERPRISE_PLAN_PRICE=25

# Briefing engine — shared secret an external cron (GitHub Actions,
# cron-job.org) presents via the X-Internal-Secret header to
# POST /api/internal/briefings/tick. Generate with `openssl rand -hex 32`.
# Endpoint returns 503 until this is set.
INTERNAL_TICK_SECRET=

# Briefing engine kill switch. Set to the literal string "false" to stop
# both the in-process hourly cron (agentRunner.js) and the external tick
# endpoint from sending anything — non-negotiable for a system that emails
# your entire user base on a timer. Unset or any other value = enabled.
BRIEFINGS_ENABLED=
